# QuestLog AI — environment configuration
# Copy this file to `.env.local` and fill in your values.

# Google AI Studio (Gemini) API key — get one at https://aistudio.google.com/apikey
AISTUDIO_API_KEY=your_aistudio_key_here

# Optional: override the Gemini model (defaults to gemini-3.6-flash).
# Examples: gemini-1.5-flash, gemini-1.5-pro, gemini-2.0-flash
AI_MODEL=gemini-3.6-flash

# Optional: override the AI base URL. Defaults to Google AI Studio's
# OpenAI-compatible endpoint. Point this elsewhere to use another provider:
# AI_BASE_URL=https://openrouter.ai/api/v1
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Guildmaster upgrade code — users enter this in the app to unlock the pro tier.
# Must start with NEXT_PUBLIC_ so it is available in the browser bundle.
# Change this to any string you want; comparison is case-insensitive.
NEXT_PUBLIC_UPGRADE_CODE=GUILDMASTER2025
